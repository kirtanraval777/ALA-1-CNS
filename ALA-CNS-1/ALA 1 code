
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Developed by Raval Kirtan: Professional Cryptographic Console</title>

    <link
        href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&family=Roboto+Mono:wght@300;400;700&display=swap"
        rel="stylesheet">

    <style>
        :root {
            --ink: #050505;
            --white: #f7f7fb;
            --muted: #a8a8b5;
            --glass: rgba(30, 29, 49, .72);
            --glass-strong: rgba(22, 21, 39, .88);
            --line: rgba(255, 255, 255, .13);
            --purple: #9b7cff;
            --violet: #7e6bff;
            --blue: #48a6ff;
            --cyan: #52d8ff;
            --green: #4de2a8;
            --red: #ff667d;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            min-height: 100vh;
            color: var(--white);
            font-family: 'Roboto Mono', monospace;

            background:
                radial-gradient(ellipse 72% 38% at 50% 24%,
                    rgba(111, 89, 255, .10),
                    transparent 70%),
                #020204;

            overflow-x: hidden;
        }

        body::before {
            content: "";
            position: fixed;
            inset: 0;
            z-index: -3;

            background-image:
                radial-gradient(rgba(255, 255, 255, .20) .7px,
                    transparent .7px);

            background-size: 6px 6px;
            opacity: .13;

            mask-image:
                linear-gradient(to bottom,
                    black 0%,
                    transparent 58%);

            pointer-events: none;
        }

        body::after {
            content: "";
            position: fixed;
            left: -10%;
            right: -10%;
            top: 23vh;
            height: 34vh;
            z-index: -2;

            background:
                radial-gradient(ellipse at 50% 0%,
                    rgba(132, 111, 255, .92) 0%,
                    rgba(111, 95, 255, .68) 18%,
                    rgba(63, 159, 255, .48) 34%,
                    transparent 67%);

            filter: blur(26px);
            transform:
                perspective(500px) rotateX(62deg) scaleY(.9);

            opacity: .92;
            pointer-events: none;
        }

        ::selection {
            background: #a38cff;
            color: #050505;
        }

        /* ================= TOP BAR ================= */

        .topbar {
            height: 58px;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 0 18px;

            background: rgba(2, 2, 4, .72);

            border-bottom:
                1px solid rgba(255, 255, 255, .06);

            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);

            position: sticky;
            top: 0;
            z-index: 50;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .brand-mark {
            width: 29px;
            height: 29px;

            display: grid;
            place-items: center;

            border-radius: 8px;

            color: #fff;

            font:
                700 .58rem 'Orbitron',
                sans-serif;

            background:
                linear-gradient(135deg,
                    #9e88ff,
                    #4d9cff);

            box-shadow:
                0 0 22px rgba(126, 107, 255, .45);
        }

        .brand-name {
            font:
                700 .76rem 'Orbitron',
                sans-serif;

            letter-spacing: 1.3px;
            color: #fff;
        }

        .brand-name span {
            color: #8d8b98;
            font-weight: 400;
            margin-left: 5px;
        }

        .top-action {
            border:
                1px solid rgba(255, 255, 255, .12);

            color: #111;
            background: #f4f4f5;

            border-radius: 999px;

            padding: 8px 15px;

            font:
                700 .62rem 'Roboto Mono',
                monospace;

            cursor: pointer;

            transition: .25s ease;
        }

        .top-action:hover {
            transform: translateY(-1px);
            background: #fff;

            box-shadow:
                0 8px 25px rgba(255, 255, 255, .12);
        }

        /* ================= MAIN ================= */

        main {
            width: 100%;
            min-height: calc(100vh - 58px);
            padding: 0 22px 70px;
        }

        /* ================= HERO ================= */

        .hero {
            max-width: 920px;

            margin: 0 auto;

            padding: 70px 20px 36px;

            text-align: center;
        }

        .eyebrow {
            display: inline-flex;

            padding: 6px 10px;

            border:
                1px solid rgba(255, 255, 255, .10);

            border-radius: 999px;

            color: #b9b6c7;

            background:
                rgba(255, 255, 255, .035);

            font-size: .58rem;

            letter-spacing: 1.4px;

            margin-bottom: 19px;
        }

        .hero h2 {
            font-family: 'Orbitron', sans-serif;

            font-size:
                clamp(2.7rem, 6vw, 5.4rem);

            line-height: .98;

            letter-spacing: -2.8px;

            font-weight: 400;

            color: #fafafa;

            text-shadow:
                0 3px 30px rgba(255, 255, 255, .08);
        }

        .hero h2 span {
            background:
                linear-gradient(90deg,
                    #fff,
                    #c9c3ff 48%,
                    #8fa9ff);

            -webkit-background-clip: text;
            background-clip: text;

            color: transparent;
        }

        .hero p {
            max-width: 620px;

            margin: 22px auto 0;

            color: #aaa8b4;

            font-size: .74rem;

            line-height: 1.8;
        }

        /* ================= CONSOLE ================= */

        .console-shell {
            position: relative;

            max-width: 1180px;

            margin: 10px auto 0;

            padding: 26px;

            border:
                1px solid rgba(255, 255, 255, .15);

            border-radius: 22px;

            background:
                linear-gradient(145deg,
                    rgba(54, 52, 82, .78),
                    rgba(16, 15, 29, .86));

            box-shadow:
                0 35px 100px rgba(0, 0, 0, .65),
                inset 0 1px 0 rgba(255, 255, 255, .08),
                0 0 90px rgba(117, 94, 255, .12);

            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);

            overflow: hidden;
        }

        .console-shell::before {
            content: "";

            position: absolute;

            width: 65%;
            height: 1px;

            left: 18%;
            top: 0;

            background:
                linear-gradient(90deg,
                    transparent,
                    #9d8cff,
                    transparent);

            box-shadow:
                0 0 18px #8b7cff;
        }

        .console-head {
            display: flex;

            align-items: center;
            justify-content: space-between;

            gap: 20px;

            padding: 2px 4px 20px;
        }

        .console-kicker {
            color: #918da3;

            font-size: .55rem;

            letter-spacing: 1.4px;

            margin-bottom: 9px;
        }

        .console-head h3 {
            font:
                400 1.08rem 'Orbitron',
                sans-serif;

            letter-spacing: -.3px;

            color: #f5f4fa;
        }

        .live-pill {
            white-space: nowrap;

            padding: 7px 10px;

            border:
                1px solid rgba(77, 226, 168, .2);

            border-radius: 999px;

            color: #86e7c0;

            background:
                rgba(77, 226, 168, .06);

            font-size: .54rem;

            letter-spacing: .8px;
        }

        .live-pill i {
            display: inline-block;

            width: 6px;
            height: 6px;

            border-radius: 50%;

            background: var(--green);

            box-shadow:
                0 0 10px var(--green);

            margin-right: 5px;
        }

        /* ================= TOOLBAR ================= */

        .console-toolbar {
            display: flex;

            justify-content: space-between;
            align-items: center;

            gap: 12px;

            margin-bottom: 18px;

            padding-bottom: 14px;

            border-bottom:
                1px solid rgba(255, 255, 255, .07);

            color: #8d8998;

            font-size: .55rem;
        }

        .toolbar-left,
        .toolbar-right {
            display: flex;

            align-items: center;

            gap: 7px;
        }

        .tool-dot {
            font-size: 1rem;
            color: #bcb5d5;
        }

        .tool-chip,
        .tool-mini {
            padding: 5px 8px;

            border-radius: 6px;

            background:
                rgba(255, 255, 255, .055);

            border:
                1px solid rgba(255, 255, 255, .06);
        }

        /* ================= ALGORITHM SELECTOR ================= */

        .algorithm-box {
            margin-bottom: 18px;

            padding: 14px;

            border:
                1px solid rgba(157, 140, 255, .20);

            border-radius: 12px;

            background:
                rgba(126, 107, 255, .045);
        }

        .algorithm-box label {
            display: block;

            font-size: .57rem;

            color: #aaa6b8;

            text-transform: uppercase;

            letter-spacing: .8px;

            margin-bottom: 8px;
        }

        #algorithm-select {
            width: 100%;

            background:
                rgba(0, 0, 0, .45);

            border:
                1px solid rgba(157, 140, 255, .25);

            border-radius: 9px;

            padding: 11px 12px;

            color: #f7f7fb;

            font-family:
                'Roboto Mono',
                monospace;

            font-size: .72rem;

            cursor: pointer;

            transition: .25s ease;
        }

        #algorithm-select:hover {
            border-color:
                rgba(157, 140, 255, .55);
        }

        #algorithm-select:focus {
            outline: none;

            border-color:
                rgba(157, 140, 255, .72);

            box-shadow:
                0 0 0 3px rgba(126, 107, 255, .08);
        }

        #algorithm-select option {
            background: #12111d;
            color: #fff;
        }

        .algorithm-info {
            margin-top: 8px;

            color: #777483;

            font-size: .52rem;

            line-height: 1.5;
        }

        /* ================= GRID ================= */

        .crypto-grid {
            display: grid;

            grid-template-columns:
                1fr 1fr;

            gap: 14px;
        }

        .crypto-panel {
            position: relative;

            overflow: hidden;

            background:
                rgba(7, 7, 14, .58);

            border:
                1px solid rgba(255, 255, 255, .10);

            border-radius: 15px;

            padding: 20px;

            display: flex;

            flex-direction: column;

            gap: 15px;

            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, .04);

            transition: .3s ease;
        }

        .crypto-panel:hover {
            border-color:
                rgba(160, 140, 255, .32);

            transform:
                translateY(-2px);

            box-shadow:
                0 15px 40px rgba(0, 0, 0, .25),
                inset 0 1px 0 rgba(255, 255, 255, .07);
        }

        .panel-title {
            font:
                700 .68rem 'Orbitron',
                sans-serif;

            color: #c5bcff;

            letter-spacing: 1px;

            display: flex;

            align-items: center;

            gap: 8px;

            border-bottom:
                1px solid rgba(255, 255, 255, .08);

            padding-bottom: 12px;
        }

        /* ================= INPUTS ================= */

        .input-group {
            display: flex;

            flex-direction: column;

            gap: 7px;
        }

        .input-group label {
            font-size: .57rem;

            color: #9895a6;

            text-transform: uppercase;

            letter-spacing: .8px;
        }

        textarea,
        input[type="text"],
        input[type="password"] {
            width: 100%;

            background:
                rgba(0, 0, 0, .34);

            border:
                1px solid rgba(255, 255, 255, .09);

            border-radius: 9px;

            padding: 11px 12px;

            color: #f7f7fb;

            font-family:
                'Roboto Mono',
                monospace;

            font-size: .72rem;

            resize: vertical;

            transition: .25s ease;
        }

        textarea {
            min-height: 82px;
        }

        textarea::placeholder,
        input::placeholder {
            color: #5e5c69;
        }

        textarea:focus,
        input:focus {
            outline: none;

            border-color:
                rgba(157, 140, 255, .72);

            box-shadow:
                0 0 0 3px rgba(126, 107, 255, .08),

                0 0 22px rgba(126, 107, 255, .10);
        }

        /* ================= BUTTONS ================= */

        .action-row {
            display: flex;

            gap: 8px;
        }

        .btn {
            flex: 1;

            border:
                1px solid rgba(157, 140, 255, .48);

            border-radius: 8px;

            padding: 10px 12px;

            color: #d9d2ff;

            background:
                rgba(126, 107, 255, .09);

            font:
                700 .6rem 'Roboto Mono',
                monospace;

            text-transform: uppercase;

            letter-spacing: .6px;

            cursor: pointer;

            transition: .25s ease;
        }

        .btn:hover:not(:disabled) {
            color: #0a0714;

            background:
                linear-gradient(135deg,
                    #b5a7ff,
                    #72b7ff);

            box-shadow:
                0 0 22px rgba(126, 107, 255, .24);

            transform:
                translateY(-1px);
        }

        .btn:disabled {
            opacity: .4;
            cursor: not-allowed;
        }

        .btn-secondary {
            color: #a5a2af;

            border-color:
                rgba(255, 255, 255, .12);

            background:
                rgba(255, 255, 255, .035);
        }

        .btn-secondary:hover:not(:disabled) {
            color: #fff;

            background:
                rgba(255, 255, 255, .10);
        }

        /* ================= STATUS ================= */

        .status-msg {
            min-height: 15px;

            font-size: .58rem;

            color: #898694;
        }

        .status-msg.success {
            color: var(--green);
        }

        .status-msg.error {
            color: var(--red);
        }

        /* ================= FOOTER ================= */

        footer {
            text-align: center;

            padding: 20px;

            color: #666472;

            background: #020204;

            border-top:
                1px solid rgba(255, 255, 255, .05);

            font-size: .57rem;

            letter-spacing: .6px;
        }

        /* ================= RESPONSIVE ================= */

        @media (max-width: 820px) {

            .hero {
                padding-top: 55px;
            }

            .crypto-grid {
                grid-template-columns: 1fr;
            }

            .console-head {
                align-items: flex-start;

                flex-direction: column;
            }
        }

        @media (max-width: 560px) {

            .topbar {
                padding: 0 12px;
            }

            .brand-name {
                font-size: .62rem;
            }

            main {
                padding: 0 12px 45px;
            }

            .hero {
                padding: 45px 8px 28px;
            }

            .hero h2 {
                font-size: 2.5rem;

                letter-spacing: -1.7px;
            }

            .hero p {
                font-size: .65rem;
            }

            .console-shell {
                padding: 15px;

                border-radius: 17px;
            }

            .crypto-panel {
                padding: 16px;
            }

            .console-toolbar {
                flex-direction: column;

                align-items: flex-start;
            }
        }
    </style>

    <!-- CryptoJS Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/crypto-js/4.2.0/crypto-js.min.js"></script>

</head>

<body>

    <!-- ================= HEADER ================= -->

    <header class="topbar">

        <div class="brand">

            <div class="brand-mark">
                RK
            </div>

            <div class="brand-name">
                RAVAL KIRTAN
                <span>CRYPTO</span>
            </div>

        </div>

        <button class="top-action"
            onclick="document.querySelector('.console-shell').scrollIntoView({behavior:'smooth'})">

            Try Console <span>↗</span>

        </button>

    </header>


    <!-- ================= MAIN ================= -->

    <main>

        <!-- HERO -->

        <section class="hero">

            <div class="eyebrow">
                SECURE DIGITAL WORKSPACE · AES / DES / 3DES
            </div>

            <h2>
                Security at the<br>
                <span>speed of cryptography</span>
            </h2>

            <p>
                Encrypt sensitive messages, protect your secret key,
                and recover data through a clean browser-based
                cryptographic console.
            </p>

        </section>


        <!-- ================= CONSOLE ================= -->

        <section class="console-shell">

            <div class="console-head">

                <div>

                    <div class="console-kicker">
                        RAVAL KIRTAN / SECURE CONSOLE
                    </div>

                    <h3>
                        What data shall we secure?
                    </h3>

                </div>

                <div class="live-pill">
                    <i></i>
                    SYSTEM READY
                </div>

            </div>


            <!-- TOOLBAR -->

            <div class="console-toolbar">

                <div class="toolbar-left">

                    <span class="tool-dot">
                        +
                    </span>

                    <span class="tool-chip">
                        🔐 Encryption
                    </span>

                    <span class="tool-chip">
                        ↔ Decryption
                    </span>

                </div>

                <div class="toolbar-right">

                    <span class="tool-mini">
                        AES / DES / 3DES
                    </span>

                </div>

            </div>


            <!-- ================= ALGORITHM SELECTOR ================= -->

            <div class="algorithm-box">

                <label for="algorithm-select">
                    Select Cryptographic Algorithm
                </label>

                <select id="algorithm-select">

                    <option value="AES">
                        AES — Advanced Encryption Standard
                    </option>

                    <option value="DES">
                        DES — Data Encryption Standard
                    </option>

                    <option value="3DES">
                        3DES — Triple Data Encryption Standard
                    </option>

                </select>

                <div class="algorithm-info">
                    Selected algorithm will be used for both
                    encryption and decryption.
                </div>

            </div>


            <!-- ================= CRYPTO GRID ================= -->

            <div class="crypto-grid">


                <!-- ================= ENCRYPTION PANEL ================= -->

                <section class="crypto-panel">

                    <div class="panel-title">
                        🔒 Data Encryption Module
                    </div>


                    <!-- Plaintext -->

                    <div class="input-group">

                        <label for="enc-plain-text">
                            Plaintext Input
                        </label>

                        <textarea id="enc-plain-text" placeholder="Type cleartext message...">
                        </textarea>

                    </div>


                    <!-- Encryption Key -->

                    <div class="input-group">

                        <label for="enc-key">
                            Secret Passphrase Key
                        </label>

                        <input type="password" id="enc-key" placeholder="Enter secret key...">

                    </div>


                    <!-- Buttons -->

                    <div class="action-row">

                        <button id="encrypt-btn" class="btn" disabled>

                            Encrypt Payload

                        </button>

                        <button id="enc-clear-btn" class="btn btn-secondary">

                            Clear

                        </button>

                    </div>


                    <!-- Encryption Output -->

                    <div class="input-group">

                        <label for="enc-output">
                            Encrypted Ciphertext Output
                        </label>

                        <textarea id="enc-output" readonly placeholder="Ciphertext will appear here...">
                        </textarea>

                    </div>


                    <div id="enc-status" class="status-msg">
                    </div>

                </section>


                <!-- ================= DECRYPTION PANEL ================= -->

                <section class="crypto-panel">

                    <div class="panel-title">
                        🔓 Data Decryption Module
                    </div>


                    <!-- Ciphertext -->

                    <div class="input-group">

                        <label for="dec-cipher-text">
                            Ciphertext Input (Auto-filled)
                        </label>

                        <textarea id="dec-cipher-text" placeholder="Waiting for encryption payload...">
                        </textarea>

                    </div>


                    <!-- Decryption Key -->

                    <div class="input-group">

                        <label for="dec-key">
                            Secret Passphrase Key (Auto-filled)
                        </label>

                        <input type="password" id="dec-key" placeholder="Waiting for key...">

                    </div>


                    <!-- Buttons -->

                    <div class="action-row">

                        <button id="decrypt-btn" class="btn" disabled>

                            Decrypt Payload

                        </button>

                        <button id="dec-clear-btn" class="btn btn-secondary">

                            Clear

                        </button>

                    </div>


                    <!-- Decryption Output -->

                    <div class="input-group">

                        <label for="dec-output">
                            Recovered Plaintext Output
                        </label>

                        <textarea id="dec-output" readonly placeholder="Recovered cleartext...">
                        </textarea>

                    </div>


                    <div id="dec-status" class="status-msg">
                    </div>

                </section>

            </div>

        </section>

    </main>


    <!-- ================= FOOTER ================= -->

    <footer>

        © 2026 Raval Kirtan |
        Developed by Raval Kirtan |
        Professional Symmetric Cryptography Suite

    </footer>


    <!-- ================= JAVASCRIPT ================= -->

    <script>

        /* ==========================================
           GET HTML ELEMENTS
        ========================================== */

        const algoSelect =
            document.getElementById('algorithm-select');


        /* Encryption elements */

        const encPlainText =
            document.getElementById('enc-plain-text');

        const encKey =
            document.getElementById('enc-key');

        const encryptBtn =
            document.getElementById('encrypt-btn');

        const encClearBtn =
            document.getElementById('enc-clear-btn');

        const encOutput =
            document.getElementById('enc-output');

        const encStatus =
            document.getElementById('enc-status');


        /* Decryption elements */

        const decCipherText =
            document.getElementById('dec-cipher-text');

        const decKey =
            document.getElementById('dec-key');

        const decryptBtn =
            document.getElementById('decrypt-btn');

        const decClearBtn =
            document.getElementById('dec-clear-btn');

        const decOutput =
            document.getElementById('dec-output');

        const decStatus =
            document.getElementById('dec-status');


        /* ==========================================
           ENCRYPTION FORM VALIDATION
        ========================================== */

        function validateEncryptionForm() {

            if (
                encPlainText.value.trim() !== "" &&
                encKey.value.trim() !== ""
            ) {

                encryptBtn.removeAttribute('disabled');

            } else {

                encryptBtn.setAttribute(
                    'disabled',
                    'true'
                );

            }
        }


        /* ==========================================
           DECRYPTION FORM VALIDATION
        ========================================== */

        function validateDecryptionForm() {

            if (
                decCipherText.value.trim() !== "" &&
                decKey.value.trim() !== ""
            ) {

                decryptBtn.removeAttribute('disabled');

            } else {

                decryptBtn.setAttribute(
                    'disabled',
                    'true'
                );

            }
        }


        /* ==========================================
           LISTEN FOR USER INPUT
        ========================================== */

        encPlainText.addEventListener(
            'input',
            validateEncryptionForm
        );

        encKey.addEventListener(
            'input',
            validateEncryptionForm
        );

        decCipherText.addEventListener(
            'input',
            validateDecryptionForm
        );

        decKey.addEventListener(
            'input',
            validateDecryptionForm
        );


        /* ==========================================
           ENCRYPTION
        ========================================== */

        encryptBtn.addEventListener(
            'click',
            () => {

                const text =
                    encPlainText.value;

                const key =
                    encKey.value;

                const algorithm =
                    algoSelect.value;


                try {

                    let encrypted;


                    /* ---------- AES ---------- */

                    if (algorithm === 'AES') {

                        encrypted =
                            CryptoJS.AES
                                .encrypt(text, key)
                                .toString();

                    }


                    /* ---------- DES ---------- */

                    else if (algorithm === 'DES') {

                        encrypted =
                            CryptoJS.DES
                                .encrypt(text, key)
                                .toString();

                    }


                    /* ---------- 3DES ---------- */

                    else if (algorithm === '3DES') {

                        encrypted =
                            CryptoJS.TripleDES
                                .encrypt(text, key)
                                .toString();

                    }


                    /* ---------- OUTPUT ---------- */

                    encOutput.value =
                        encrypted;


                    encStatus.textContent =
                        algorithm +
                        " encryption completed successfully.";

                    encStatus.className =
                        "status-msg success";


                    /* ==================================
                       AUTO TRANSFER TO DECRYPTION
                    ================================== */

                    decCipherText.value =
                        encrypted;

                    decKey.value =
                        key;


                    validateDecryptionForm();


                    decStatus.textContent =
                        "Payload auto-transferred using " +
                        algorithm +
                        ".";

                    decStatus.className =
                        "status-msg success";

                }


                catch (err) {

                    encOutput.value = "";

                    encStatus.textContent =
                        "Encryption failed: " +
                        err.message;

                    encStatus.className =
                        "status-msg error";

                }

            }
        );


        /* ==========================================
           DECRYPTION
        ========================================== */

        decryptBtn.addEventListener(
            'click',
            () => {

                const ciphertext =
                    decCipherText.value.trim();

                const key =
                    decKey.value;

                const algorithm =
                    algoSelect.value;


                try {

                    let decryptedBytes;


                    /* ---------- AES ---------- */

                    if (algorithm === 'AES') {

                        decryptedBytes =
                            CryptoJS.AES.decrypt(
                                ciphertext,
                                key
                            );

                    }


                    /* ---------- DES ---------- */

                    else if (algorithm === 'DES') {

                        decryptedBytes =
                            CryptoJS.DES.decrypt(
                                ciphertext,
                                key
                            );

                    }


                    /* ---------- 3DES ---------- */

                    else if (algorithm === '3DES') {

                        decryptedBytes =
                            CryptoJS.TripleDES.decrypt(
                                ciphertext,
                                key
                            );

                    }


                    /* ==================================
                       CONVERT BYTES TO TEXT
                    ================================== */

                    const decryptedText =
                        decryptedBytes.toString(
                            CryptoJS.enc.Utf8
                        );


                    /* ==================================
                       INVALID KEY / DATA CHECK
                    ================================== */

                    if (!decryptedText) {

                        throw new Error(
                            "Invalid key or corrupted ciphertext."
                        );

                    }


                    /* ==================================
                       OUTPUT
                    ================================== */

                    decOutput.value =
                        decryptedText;


                    decStatus.textContent =
                        algorithm +
                        " decryption verified successfully.";

                    decStatus.className =
                        "status-msg success";

                }


                catch (err) {

                    decOutput.value = "";

                    decStatus.textContent =
                        "Decryption failed: Incorrect key, " +
                        "wrong algorithm, or corrupted ciphertext.";

                    decStatus.className =
                        "status-msg error";

                }

            }
        );


        /* ==========================================
           ENCRYPTION CLEAR BUTTON
        ========================================== */

        encClearBtn.addEventListener(
            'click',
            () => {

                encPlainText.value = "";

                encKey.value = "";

                encOutput.value = "";

                encStatus.textContent = "";

                validateEncryptionForm();

            }
        );


        /* ==========================================
           DECRYPTION CLEAR BUTTON
        ========================================== */

        decClearBtn.addEventListener(
            'click',
            () => {

                decCipherText.value = "";

                decKey.value = "";

                decOutput.value = "";

                decStatus.textContent = "";

                validateDecryptionForm();

            }
        );


        /* ==========================================
           ALGORITHM CHANGE
        ========================================== */

        algoSelect.addEventListener(
            'change',
            () => {

                /* Clear previous results */

                encOutput.value = "";

                decOutput.value = "";

                encStatus.textContent = "";

                decStatus.textContent = "";


                /* Update toolbar */

                const toolMini =
                    document.querySelector('.tool-mini');

                toolMini.textContent =
                    algoSelect.value;


                /* Show selected algorithm */

                const algorithmInfo =
                    document.querySelector('.algorithm-info');

                algorithmInfo.textContent =
                    "Current algorithm: " +
                    algoSelect.value +
                    ". Use the same algorithm and key for decryption.";

            }
        );

    </script>

</body>

</html>
